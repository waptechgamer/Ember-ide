modules = ["python-3.12", "bash"]

[nix]
channel = "stable-25_05"
packages = ["awsebcli", "libGL", "gcc-unwrapped", "glib", "fontconfig", "xorg.libxcb", "xorg.libX11", "xorg.libXext", "libxkbcommon", "dbus", "xorg.xcbutil", "xorg.xcbutilimage", "xorg.xcbutilkeysyms", "xorg.xcbutilrenderutil", "xorg.xcbutilwm"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ember IDE"

[[workflows.workflow]]
name = "Ember IDE"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "vnc"
